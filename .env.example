NODE_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Bangkok
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
SESSION_COOKIE_NAME=dve_session
SESSION_TTL_MINUTES=480
AUTH_MODE=mock
DATA_MODE=mock
DVE_UPLOAD_DIR=C:\DigitalVerse\uploads
DVE_EXPORT_DIR=C:\DigitalVerse\exports
DVE_LOG_DIR=C:\DigitalVerse\logs
DVE_MAX_UPLOAD_MB=25
DVE_MAX_QUERY_ROWS=5000
DVE_MAX_EXPORT_ROWS=50000
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=DigitalVerse
SQL_USERNAME=replace-me
SQL_PASSWORD=replace-me
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false
DVE_INTEGRATION_KEY=replace-with-a-long-random-value
REFRESH_WORKER_POLL_SECONDS=30
