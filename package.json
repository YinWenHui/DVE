{
  "name": "digital-verse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0",
    "dev:local": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint src tests scripts workers *.ts *.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "worker": "tsx workers/refresh-worker.ts",
    "dev:all": "concurrently -k -n web,worker -c cyan,magenta \"npm:dev\" \"npm:worker\"",
    "create-admin": "tsx scripts/create-admin.ts",
    "db:migrate": "tsx scripts/initialize-database.ts",
    "check": "npm run lint && npm run type-check && npm test && npm run build"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "echarts": "^6.0.0",
    "html-to-image": "^1.11.13",
    "jose": "^6.1.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mssql": "^12.0.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-grid-layout": "^1.5.2",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/mssql": "^9.1.8",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-grid-layout": "^1.3.6",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^27.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
